# ResQNet Configuration Environment Variables
PROJECT_NAME="ResQNet AI Flood Prediction System"
VERSION="1.0.0"

# Backend
PORT=8000
HOST="0.0.0.0"
DATABASE_URL="sqlite:///resqnet.db"

# Open-Meteo Weather API
OPEN_METEO_FORECAST_URL="https://api.open-meteo.com/v1/forecast"
WEATHER_CACHE_TTL_SECONDS=900

# Operational Risk Thresholds (Calibrated Probabilities)
THRESHOLD_MODERATE_ADVISORY=0.03
THRESHOLD_HIGH_WARNING=0.12

# Physical Thresholds (KSNDMC Criteria)
KSNDMC_HEAVY_RAIN_MM=64.5
KSNDMC_VERY_HEAVY_RAIN_MM=115.6
KSNDMC_EXTREME_RAIN_MM=204.4

# Warning Suppression
WARNING_COOLDOWN_SECONDS=10800
