<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Do not backup private SOS incident keys or location telemetry -->
        <exclude domain="database" path="resqnet_sos_db" />
        <exclude domain="sharedpref" path="org.resqnet.sos_preferences.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="resqnet_sos_db" />
    </device-transfer>
</data-extraction-rules>
